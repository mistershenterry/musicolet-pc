{
  "name": "musicolet-pc",
  "version": "1.0.7",
  "description": "An offline desktop music player for Windows/macOS/Linux inspired by Musicolet for Android: multiple queues, folders, synced lyrics, tag editor, equalizer and sleep timer.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mistershenterry/musicolet-pc.git"
  },
  "keywords": [],
  "author": "mistershenterry",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mistershenterry/musicolet-pc/issues"
  },
  "homepage": "https://github.com/mistershenterry/musicolet-pc#readme",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "Musicolet PC",
  "build": {
    "appId": "com.mistershenterry.musicoletpc",
    "productName": "Musicolet PC",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Musicolet-PC-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Musicolet-PC-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "icon": "src/assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mistershenterry",
        "repo": "musicolet-pc"
      }
    ]
  }
}
